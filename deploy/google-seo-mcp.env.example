# /etc/google-seo-mcp.env  (chmod 600)
MCP_TRANSPORT=http
# Keep loopback and put Nginx/Caddy in front; use 0.0.0.0 only with a token + firewall.
MCP_HOST=127.0.0.1
MCP_PORT=8080
MCP_PATH=/mcp
# Generate with openssl rand -hex 32.
MCP_AUTH_TOKEN=change-me-to-a-long-random-string
# Replace with your actual public origin; also sets trusted Host/Origin.
SEO_MCP_PUBLIC_URL=https://mcp.example.com
# One of:
GOOGLE_APPLICATION_CREDENTIALS=/etc/google-seo-mcp/service-account.json
# Alternatively, use the authorized_user file produced by npm run auth:
# GOOGLE_APPLICATION_CREDENTIALS=/etc/google-seo-mcp/credentials.json
